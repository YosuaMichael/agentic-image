# Copy to .env (gitignored) and fill in. Never commit real keys.
# Hugging Face token for the gated Ideogram 4 weight downloads.
# Accept the gate first: https://huggingface.co/ideogram-ai/ideogram-4-nf4
HF_TOKEN="hf_..."

# Ideogram API key for the free hosted magic-prompt expansion
# (get one at https://ideogram.ai/platform). Needed unless --no-magic-prompt.
IDEOGRAM_API_KEY="..."

# Optional: OpenRouter key when using a claude-* magic-prompt model.
MAGIC_PROMPT_API_KEY=""

# Optional: Hive safety screening keys (prompt + output moderation).
# Strongly recommended by upstream; without them screening is disabled.
HIVE_TEXT_MODERATION_KEY=""
HIVE_VISUAL_MODERATION_KEY=""
